# ============================================================
# 敏感配置示例文件
#
# 使用方法：复制本文件为项目根目录下的 .env，填入真实值。
# .env 已被 .gitignore 忽略，不会提交到版本库。
#
# 优先级说明：
# - 直接在操作系统中设置同名环境变量时，系统环境变量优先于 .env 文件
# - 两个变量都未设置时，框架使用 frame/config/*.yaml 中的占位值（无法访问真实环境）
# ============================================================

WECOM_CORPID=ww_your_corpid_here
WECOM_CORPSECRET=your_corp_secret_here
